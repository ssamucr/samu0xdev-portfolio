---
import Heading from "@components/ui/Heading.astro";
import LogItem from "@components/ui/LogItem.astro";
import { useTranslations, type Lang } from "@i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const experiences = [
    {
        date: `[2026.09 - ${t('experience.present')}]`,
        active: true,
        role: { en: "Data Engineer", es: "Ingeniero de Datos" },
        company: "@Banco Delta",
        description: {
            en: [
                "Designed and built a Microsoft Fabric lakehouse with a star schema that centralizes data from the bank's source systems (OnBase, Bantotal and Payme), including pipelines, Dataflows Gen2 and notebooks",
                "Replaced QlikView and the Azure warehouse with the lakehouse and Power BI, rebuilding most core dashboards with the same analytics and more information, cutting costs and improving refresh times",
                "Built the Payme integration and an automated Fabric notebook that computes and stores the daily delinquency behavior score of the active loan portfolio; now building a probability-of-default model on top of it",
                "Built a Balanced Scorecard dashboard to track execution, goals and commissions for sales and collections staff"
            ],
            es: [
                "Diseñé y construí un lakehouse en Microsoft Fabric con modelo estrella que centraliza los datos de los sistemas fuente del banco (OnBase, Bantotal y Payme), incluyendo pipelines, Dataflows Gen2 y notebooks",
                "Reemplacé QlikView y el warehouse en Azure por el lakehouse y Power BI, reconstruyendo la mayoría de los tableros centrales con la misma analítica y más información, reduciendo costos y mejorando los tiempos de actualización",
                "Creé la integración con Payme y un notebook automático en Fabric que calcula y almacena diariamente el score de comportamiento de mora de la cartera activa de préstamos; actualmente construyo un modelo de probabilidad de incumplimiento sobre él",
                "Construí un tablero de Balanced Scorecard para el seguimiento de ejecución, metas y comisiones de vendedores y cobradores"
            ]
        }
    },
    {
        date: `[2026.07 - ${t('experience.present')}]`,
        active: true,
        role: { en: "SQL Instructor (part-time)", es: "Profesor de SQL (tiempo parcial)" },
        company: "@iacademy",
        description: {
            en: [
                "Teach the basic SQL course through recorded and live synchronous classes"
            ],
            es: [
                "Facilito el curso de SQL básico mediante clases grabadas y sincrónicas"
            ]
        }
    },
    {
        date: "[2024.09 - 2026.08]",
        active: false,
        role: { en: "Programmer Analyst / Data Analyst", es: "Analista Programador / Analista de Datos" },
        company: "@Banco Delta",
        description: {
            en: [
                "Implemented a FastAPI service and BPM workflow automation with generative AI (GPT), cutting workflow instance lifetime by 50% and meeting regulatory deadlines",
                "Built advanced SQL queries and reporting in Power BI, Reporting Services and QlikView; optimized complex queries and data flows",
                "Created and maintained ETL in Fabric Pipelines, Integration Services and Data Factory, with monitoring dashboards that ensure data availability"
            ],
            es: [
                "Implementé una API con FastAPI y automaticé flujos BPM con IA generativa (GPT), reduciendo en un 50% el tiempo de vida de las instancias del flujo y cumpliendo los tiempos regulatorios",
                "Construí consultas SQL avanzadas y reportería en Power BI, Reporting Services y QlikView; optimicé consultas y flujos de datos complejos",
                "Creé y mantuve ETL en Fabric Pipelines, Integration Services y Data Factory, con dashboards de monitoreo que aseguran la disponibilidad de los datos"
            ]
        }
    },
    {
        date: "[2025]",
        active: false,
        role: { en: "Full Stack Developer", es: "Desarrollador Full Stack" },
        company: "@UTP AWS Academic Project",
        description: {
            en: [
                "Designed and deployed a cloud-native full-stack application on AWS using a serverless architecture",
                "Built scalable backend services with FastAPI and PostgreSQL, integrated with a modern Next.js frontend",
                "Architected cloud infrastructure with Amplify, API Gateway, Lambda, and RDS following best practices"
            ],
            es: [
                "Diseñé y desplegué una aplicación full stack cloud-native en AWS con una arquitectura serverless",
                "Construí servicios backend escalables con FastAPI y PostgreSQL, integrados con un frontend moderno en Next.js",
                "Diseñé la infraestructura en la nube con Amplify, API Gateway, Lambda y RDS siguiendo buenas prácticas"
            ]
        }
    },
    {
        date: "[2022 - 2023]",
        active: false,
        role: { en: "Full Stack Developer", es: "Desarrollador Full Stack" },
        company: "@Reto Innova Banesco",
        description: {
            en: [
                "Earned 2nd place (2022) and 1st place (2023) in the hackathon",
                "Designed and implemented a full-stack architecture with Django REST Framework and React, with RESTful APIs and custom authorization middleware",
                "Modeled and optimized the MySQL database for complex legal and financial case management",
                "Automated 80% of manual processes, including Word legal documents and email notifications, with multi-role workflows and custom dashboards"
            ],
            es: [
                "Obtuve el 2.º lugar (2022) y el 1.er lugar (2023) en el hackathon",
                "Diseñé e implementé una arquitectura full stack con Django REST Framework y React, con APIs RESTful y middleware de autorización personalizado",
                "Modelé y optimicé la base de datos MySQL para la gestión de casos legales y financieros complejos",
                "Automaticé el 80% de los procesos manuales, incluyendo documentos legales en Word y notificaciones por email, con workflows multi-rol y dashboards personalizados"
            ]
        }
    }
];

---

<section id="experience-section" class="mb-15">
    <div class="heading">
        <Heading number={4} text={t('experience.title')} />
    </div>
    <div class="experiences-container pl-5">
        {
            experiences.map((experience, index) => (
                <div class={`log-item ${experience.active ? 'log-item-active' : ''}`}>
                    <LogItem
                        date={experience.date}
                        active={experience.active}
                        role={experience.role[lang]}
                        company={experience.company}
                        description={experience.description[lang]}
                        lang={lang}
                    />
                </div>
            ))
        }
    </div>
</section>

<style>
    .experiences-container {
        display: grid;
        grid-template-columns: 1fr;
        grid-auto-rows: auto;
        gap: 48px;
        border-left: 2px solid var(--color-text-tertiary);
    }
    .log-item {
        position: relative;
    }

    .log-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: -27px;
        width: 12px;
        height: 12px;
        box-sizing: border-box;
        border: 2px solid var(--color-text-quaternary);
        border-radius: 50%;
        background: var(--color-bg);
        transform: translateY(-50%);
    }

    .log-item-active {
        position: relative;
    }

    .log-item-active::before {
        content: "";
        position: absolute;
        top: 0;
        left: -27px;
        width: 12px;
        height: 12px;
        box-sizing: border-box;
        border: 2px solid var(--color-accent);
        border-radius: 50%;
        background: var(--color-bg);
        transform: translateY(-50%);
        box-shadow:
            0 0 4px rgba(192, 193, 255, 1),
            0 0 12px rgba(192, 193, 255, 0.95),
            0 0 28px rgba(192, 193, 255, 0.8),
            0 0 56px rgba(192, 193, 255, 0.6);
    }

</style>