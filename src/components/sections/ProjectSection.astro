---
import Heading from "@components/ui/Heading.astro";
import Project from "@components/ui/Project.astro";
import templateImg from "@assets/images/projects/template.webp";
import { useTranslations, type Lang } from "@i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const projects = [
    {
        title: "Finance Tracker",
        description: {
            en: "A web application to track personal finances and manage budgets. Users can categorize expenses, set budget goals, and visualize spending patterns.",
            es: "Una aplicación web para llevar el control de finanzas personales y presupuestos. Permite categorizar gastos, definir metas de ahorro y visualizar patrones de gasto."
        },
        techStack: ["React", "TypeScript", "Tailwind CSS"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "E-commerce Platform",
        description: {
            en: "A full-featured e-commerce platform that allows users to browse products, add items to a shopping cart, and securely checkout using Stripe.",
            es: "Una plataforma de comercio electrónico completa donde los usuarios exploran productos, agregan artículos al carrito y pagan de forma segura con Stripe."
        },
        techStack: ["Next.js", "Node.js", "MongoDB"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Social Media Dashboard",
        description: {
            en: "A dashboard for social media analytics that aggregates data from multiple platforms and provides insights through interactive charts and graphs.",
            es: "Un panel de analítica de redes sociales que agrega datos de múltiples plataformas y ofrece información mediante gráficos interactivos."
        },
        techStack: ["Vue.js", "Django", "PostgreSQL"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Task Management App",
        description: {
            en: "A task management application that helps users organize their to-do lists, set reminders, and collaborate with team members in real-time.",
            es: "Una aplicación de gestión de tareas que ayuda a organizar listas de pendientes, definir recordatorios y colaborar con el equipo en tiempo real."
        },
        techStack: ["Angular", "Firebase", "Bootstrap"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Personal Blog",
        description: {
            en: "A personal blogging platform that allows users to create and publish blog posts, customize their themes, and engage with readers through comments.",
            es: "Una plataforma de blogs personales para crear y publicar entradas, personalizar temas e interactuar con los lectores mediante comentarios."
        },
        techStack: ["Gatsby", "GraphQL", "Contentful"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Fitness Tracker",
        description: {
            en: "A fitness tracking application that enables users to log workouts, set fitness goals, and track progress over time with visual analytics.",
            es: "Una aplicación de fitness que permite registrar entrenamientos, definir metas y seguir el progreso con analíticas visuales."
        },
        techStack: ["Svelte", "Go", "MySQL"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    }
];
---

<section id="projects-section" class="mb-15">
    <Heading number={2} text={t('projects.title')} />
    <div class="projects-container">
        {projects.map((project) => (
            <div class={"div" + (projects.indexOf(project) + 1)}>
                <Project
                    title={project.title}
                    description={project.description[lang]}
                    lang={lang}
                    techStack={project.techStack}
                    imageUrl={project.imageUrl}
                    projectUrl={project.projectUrl}
                    githubUrl={project.githubUrl}
                />
            </div>
        ))}
        <div class="div7 rounded-2xl overflow-hidden shadow-lg flex flex-row md:flex-col items-center justify-center gap-6 md:gap-4 cursor-pointer">
            <p class="px-7 py-5 text-accent rounded-2xl font-bold text-xl" style="background-color: #C0C1FF1A;">+</p>
            <div class="flex flex-col items-start md:items-center justify-center">
                <p class="font-body text-text-primary font-bold text-md sm:text-lg lg:text-xl">
                    {t('projects.more')}
                </p>
                <p class="font-body text-text-secondary font-normal text-xs sm:text-xs lg:text-md z-20 flex items-center">
                    {t('projects.moreSub')}
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Mobile (diseno Figma): primera tarjeta a todo el ancho, el resto de a dos, "More" como fila */
    .projects-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }
    .div1, .div7 { grid-column: 1 / -1; }
    .projects-container > :nth-child(even):nth-last-child(2) { grid-column: 1 / -1; }
    .div7 { background-color: #131313; min-height: 7rem; padding: 1.5rem 1rem; }

    /* md+: mosaico de 4 columnas */
    @media (min-width: 768px) {
        .projects-container {
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(4, 1fr);
        }
        .projects-container > :nth-child(even):nth-last-child(2) { grid-column: 2 / 4; }
        .div1 { grid-area: 1 / 1 / 2 / 3; }
        .div2 { grid-area: 1 / 3 / 3 / 5; }
        .div3 { grid-area: 2 / 1 / 4 / 3; }
        .div4 { grid-area: 3 / 3 / 4 / 5; }
        .div5 { grid-area: 4 / 1 / 5 / 2; }
        .div6 { grid-area: 4 / 2 / 5 / 4; }
        .div7 { grid-area: 4 / 4 / 5 / 5; min-height: 0; padding: 0; }
    }
</style>