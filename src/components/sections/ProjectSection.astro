---
import Heading from "@components/ui/Heading.astro";
import Project from "@components/ui/Project.astro";
import templateImg from "@assets/images/projects/template.webp";

const projects = [
    {
        title: "Finance Tracker",
        description: "A web application to track personal finances and manage budgets. Users can categorize expenses, set budget goals, and visualize spending patterns.",
        techStack: ["React", "TypeScript", "Tailwind CSS"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "E-commerce Platform",
        description: "A full-featured e-commerce platform that allows users to browse products, add items to a shopping cart, and securely checkout using Stripe.",
        techStack: ["Next.js", "Node.js", "MongoDB"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Social Media Dashboard",
        description: "A dashboard for social media analytics that aggregates data from multiple platforms and provides insights through interactive charts and graphs.",
        techStack: ["Vue.js", "Django", "PostgreSQL"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Task Management App",
        description: "A task management application that helps users organize their to-do lists, set reminders, and collaborate with team members in real-time.",
        techStack: ["Angular", "Firebase", "Bootstrap"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Personal Blog",
        description: "A personal blogging platform that allows users to create and publish blog posts, customize their themes, and engage with readers through comments.",
        techStack: ["Gatsby", "GraphQL", "Contentful"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    },
    {
        title: "Fitness Tracker",
        description: "A fitness tracking application that enables users to log workouts, set fitness goals, and track progress over time with visual analytics.",
        techStack: ["Svelte", "Go", "MySQL"],
        imageUrl: templateImg,
        projectUrl: "https://project.com",
        githubUrl: "https://github.com/project"
    }
];
---

<section class="mb-15">
    <Heading number={2} text="Projects" />
    <div class="projects-container">
        {projects.map((project) => (
            <div class={"div" + (projects.indexOf(project) + 1)}>
                <Project
                    title={project.title}
                    description={project.description}
                    techStack={project.techStack}
                    imageUrl={project.imageUrl}
                    projectUrl={project.projectUrl}
                    githubUrl={project.githubUrl}
                />
            </div>
        ))}
        <div class="div7 rounded-2xl overflow-hidden shadow-lg flex flex-col items-center justify-center gap-4 cursor-pointer">
            <p class="px-7 py-5 text-accent rounded-2xl font-bold text-xl" style="background-color: #C0C1FF1A;">+</p>
            <div class="flex flex-col items-center justify-center">
                <p class="font-body text-text-primary font-bold text-md sm:text-lg lg:text-xl">
                    More Projects
                </p>
                <p class="font-body text-text-secondary font-normal text-xs sm:text-xs lg:text-md z-20 flex items-center">
                    Check out my lab experiments
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .projects-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 1fr);
        gap: 12px;
    }
    .div1 { grid-area: 1 / 1 / 2 / 3; }
    .div2 { grid-area: 1 / 3 / 3 / 5; }
    .div3 { grid-area: 2 / 1 / 4 / 3; }
    .div4 { grid-area: 3 / 3 / 4 / 5; }
    .div5 { grid-area: 4 / 1 / 5 / 2; }
    .div6 { grid-area: 4 / 2 / 5 / 4; }
    .div7 { grid-area: 4 / 4 / 5 / 5; background-color: #131313;}
</style>