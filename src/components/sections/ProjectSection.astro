---
import Heading from "@components/ui/Heading.astro";
import Project from "@components/ui/Project.astro";
import templateImg from "@assets/images/projects/template.webp";
import ecoImg from "@assets/images/projects/eco.webp";
import covidImg from "@assets/images/projects/covid.webp";
import alasImg from "@assets/images/projects/alas.webp";
import sismosImg from "@assets/images/projects/sismos.webp";
import focusTimerImg from "@assets/images/projects/focus-timer.webp";
import { useTranslations, type Lang } from "@i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const projects = [
    {
        title: "Eco",
        description: {
            en: "Personal finance app: accounts, cards, transactions, debts, recurring plans and installments, with analytics exportable to Excel and PDF.",
            es: "App de finanzas personales: cuentas, tarjetas, movimientos, deudas, planes recurrentes y cuotas, con analítica exportable a Excel y PDF."
        },
        techStack: ["React", "FastAPI", "PostgreSQL", "Supabase"],
        imageUrl: ecoImg,
        projectUrl: "https://eco-app-sooty.vercel.app",
        githubUrl: "https://github.com/ssamucr/eco-app-frontend"
    },
    {
        title: "COVID-19 Dashboard",
        description: {
            en: "Interactive dashboard on the spread of COVID-19: global totals, per-country charts and a vaccination map, built on Our World in Data.",
            es: "Dashboard interactivo sobre la propagación del COVID-19: totales globales, gráficas por país y un mapa de vacunación, sobre datos de Our World in Data."
        },
        techStack: ["Python", "Dash", "Plotly", "Pandas"],
        imageUrl: covidImg,
        projectUrl: "https://covid-dashboard-6ejn.onrender.com",
        githubUrl: "https://github.com/ssamucr/covid_data_analysis_visualization"
    },
    {
        title: "Alas Catalog",
        description: {
            en: "Fine jewelry catalog with category filters, fuzzy search and WhatsApp contact. The inventory updates straight from an Excel sheet.",
            es: "Catálogo de joyería fina con filtros por categoría, búsqueda difusa y contacto por WhatsApp. El inventario se actualiza desde una hoja de Excel."
        },
        techStack: ["Astro", "Tailwind CSS", "Python"],
        imageUrl: alasImg,
        projectUrl: "https://alas-catalog.vercel.app",
        githubUrl: "https://github.com/ssamucr/alas-catalog"
    },
    {
        title: "Sismos de Panamá",
        description: {
            en: "Live dashboard of an earthquake sequence in Panama: interactive map, magnitude chart and event list, fed by the USGS API.",
            es: "Panel en vivo de una secuencia sísmica en Panamá: mapa interactivo, gráfica de magnitudes y lista de eventos, con datos de la API de USGS."
        },
        techStack: ["JavaScript", "D3.js", "USGS API"],
        imageUrl: sismosImg,
        projectUrl: "https://sismos-panama.vercel.app",
        githubUrl: "https://github.com/ssamucr/sismos-panama"
    },
    {
        title: "Focus Timer",
        description: {
            en: "Minimal dark countdown timer with an animated background.",
            es: "Temporizador de cuenta regresiva minimalista, en modo oscuro y con fondo animado."
        },
        techStack: ["React", "TypeScript", "Vite"],
        imageUrl: focusTimerImg,
        projectUrl: "https://focus-timer-peach-nine.vercel.app",
        githubUrl: "https://github.com/ssamucr/focus-timer"
    },
    {
        title: "Apartment Manager",
        description: {
            en: "Rental apartment management: create, edit, list and delete listings through a REST API on AWS.",
            es: "Gestión de apartamentos en alquiler: crea, edita, lista y elimina registros a través de una API REST en AWS."
        },
        techStack: ["React", "TypeScript", "AWS"],
        imageUrl: templateImg,
        githubUrl: "https://github.com/ssamucr/rent-crud-aws"
    }
];
---

<section id="projects-section" class="mb-15">
    <Heading number={2} text={t('projects.title')} />
    <div class="projects-container">
        {projects.map((project) => (
            <div class={"div" + (projects.indexOf(project) + 1)}>
                <Project
                    title={project.title}
                    description={project.description[lang]}
                    lang={lang}
                    techStack={project.techStack}
                    imageUrl={project.imageUrl}
                    projectUrl={project.projectUrl}
                    githubUrl={project.githubUrl}
                />
            </div>
        ))}
        <div class="div7 rounded-2xl overflow-hidden shadow-lg flex flex-row md:flex-col items-center justify-center gap-6 md:gap-4 cursor-pointer">
            <p class="px-7 py-5 text-accent rounded-2xl font-bold text-xl" style="background-color: #C0C1FF1A;">+</p>
            <div class="flex flex-col items-start md:items-center justify-center">
                <p class="font-body text-text-primary font-bold text-md sm:text-lg lg:text-xl">
                    {t('projects.more')}
                </p>
                <p class="font-body text-text-secondary font-normal text-xs sm:text-xs lg:text-md z-20 flex items-center">
                    {t('projects.moreSub')}
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Mobile (diseno Figma): primera tarjeta a todo el ancho, el resto de a dos, "More" como fila */
    .projects-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }
    .div1, .div7 { grid-column: 1 / -1; }
    .projects-container > :nth-child(even):nth-last-child(2) { grid-column: 1 / -1; }
    .div7 { background-color: #131313; min-height: 7rem; padding: 1.5rem 1rem; }

    /* md+: mosaico de 4 columnas */
    @media (min-width: 768px) {
        .projects-container {
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(4, 1fr);
        }
        .projects-container > :nth-child(even):nth-last-child(2) { grid-column: 2 / 4; }
        .div1 { grid-area: 1 / 1 / 2 / 3; }
        .div2 { grid-area: 1 / 3 / 3 / 5; }
        .div3 { grid-area: 2 / 1 / 4 / 3; }
        .div4 { grid-area: 3 / 3 / 4 / 5; }
        .div5 { grid-area: 4 / 1 / 5 / 2; }
        .div6 { grid-area: 4 / 2 / 5 / 4; }
        .div7 { grid-area: 4 / 4 / 5 / 5; min-height: 0; padding: 0; }
    }
</style>