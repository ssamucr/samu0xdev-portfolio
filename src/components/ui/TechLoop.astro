---
import ReactIcon from "../icons/ReactIcon.astro";
import PythonIcon from "../icons/PythonIcon.astro";
import PostgreIcon from "../icons/PostgreIcon.astro";
import NodeIcon from "../icons/NodeIcon.astro";
import DockerIcon from "../icons/DockerIcon.astro";
import JavascriptIcon from "../icons/JavascriptIcon.astro";
import GitIcon from "../icons/GitIcon.astro";
import AstroIcon from "../icons/AstroIcon.astro";
import TypescriptIcon from "../icons/TypescriptIcon.astro";
import LinuxIcon from "../icons/LinuxIcon.astro";

const techs = [
  {
    name: "TypeScript",
    component: TypescriptIcon,
  },
  {
    name: "Python",
    component: PythonIcon,
  },
  {
    name: "React",
    component: ReactIcon,
  },
  {
    name: "Astro",
    component: AstroIcon,
  },
  {
    name: "Node.js",
    component: NodeIcon,
  },
  {
    name: "Docker",
    component: DockerIcon,
  },
  {
    name: "PostgreSQL",
    component: PostgreIcon,
  },
  {
    name: "Git",
    component: GitIcon,
  },
  {
    name: "Linux",
    component: LinuxIcon,
  },
  {
    name: "JavaScript",
    component: JavascriptIcon,
  }
];

// Duplicamos para el loop infinito
const allTechs = [...techs, ...techs];
---

<div class="bg-loop rotate-3 overflow-hidden py-4">
  <div class="tech-track flex gap-12 items-center w-max">
    {allTechs.map((tech) => (
      <div class="tech-item flex items-center gap-3 shrink-0">
        {tech.component
          ? <tech.component class="text-text-primary w-8 h-8 block" />
          : null
        }
        <span class="font-body text-text-primary text-sm font-medium whitespace-nowrap">{tech.name}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .bg-loop {
    background-color: var(--color-loop);
  }

  .tech-track {
    animation: marquee 28s linear infinite;
  }

  .tech-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-track {
      animation: none;
    }
  }
</style>