---
---

<div class="pp-wrapper">
    <canvas id="particle-profile-canvas"></canvas>
</div>

<style>
    .pp-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    #particle-profile-canvas {
        display: block;
        cursor: crosshair;
    }
</style>

<script>
    import particleData from 'virtual:particle-data';

    const canvas  = document.getElementById('particle-profile-canvas') as HTMLCanvasElement;
    const ctx     = canvas.getContext('2d')!;
    const wrapper = canvas.parentElement!;

    const REF = particleData.refSize; // 450

    // Portfolio brand colors
    const DARK  = { r: 47,  g: 46,  b: 190 }; // #2F2EBE  accent-deep
    const LIGHT = { r: 192, g: 193, b: 255 }; // #C0C1FF  accent

    // Physics
    const FRICTION  = 0.92;
    const PULL_BASE = 0.01;
    const PULL_MAX  = 0.08;
    const FADE_DUR  = 1.5;  // seconds
    const MOVE_DUR  = 2.5;  // seconds
    const DELAY_MAX = 0.3;  // seconds

    // Glitch
    const GLITCH_INTENS = 15;
    const GLITCH_STRONG = 30;
    const GLITCH_PROB   = 0.02;
    const GLITCH_DECAY  = 0.8;
    const GLITCH_FREQ   = 3;
    const SCAN_THRESH   = 10;

    // Floating decoration
    const FLOAT_N      = 30;
    const FLOAT_SPEED  = 0.5;
    const FLOAT_SZ_MIN = 0.5;
    const FLOAT_SZ_MAX = 2.5;
    const FLOAT_AL_MIN = 0.1;
    const FLOAT_AL_MAX = 0.4;

    const MOUSE_RAD_REF = 60; // px at REF_SIZE

    // Mutable state
    let size        = 0;
    let sc          = 1;   // scale = size / REF
    let mouseRadius = MOUSE_RAD_REF;
    let t0          = performance.now();
    let rafId: number | null = null;
    let ready       = false;

    const mouse = { x: -1000, y: -1000, on: false };

    canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.on = true;
    });
    canvas.addEventListener('mouseleave', () => { mouse.on = false; });
    canvas.addEventListener('touchmove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        mouse.x = touch.clientX - rect.left;
        mouse.y = touch.clientY - rect.top;
        mouse.on = true;
    }, { passive: true });
    canvas.addEventListener('touchend', () => { mouse.on = false; });

    // ---- FloatingParticle ----
    class FloatingParticle {
        x: number; y: number;
        sz: number; vx: number; vy: number; color: string;

        constructor() {
            this.x  = Math.random() * size;
            this.y  = Math.random() * size;
            this.sz = FLOAT_SZ_MIN + Math.random() * (FLOAT_SZ_MAX - FLOAT_SZ_MIN);
            this.vx = (Math.random() - 0.5) * FLOAT_SPEED;
            this.vy = (Math.random() - 0.5) * FLOAT_SPEED;
            const a = FLOAT_AL_MIN + Math.random() * (FLOAT_AL_MAX - FLOAT_AL_MIN);
            const c = Math.random() > 0.5 ? DARK : LIGHT;
            this.color = `rgba(${c.r},${c.g},${c.b},${a})`;
        }

        update() {
            this.x += this.vx; this.y += this.vy;
            if (this.x < 0 || this.x > size) this.vx *= -1;
            if (this.y < 0 || this.y > size) this.vy *= -1;
        }

        draw() {
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.sz, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    // ---- Particle ----
    type PData = (typeof particleData.particles)[number];

    class Particle {
        ix: number; iy: number; // target position (image)
        x:  number; y:  number; // current position
        br: number;             // brightness 0-255
        ll: number;             // lineLength (scaled)
        lw: number;             // lineWidth
        vx = 0; vy = 0;
        baseAlpha: number;
        alpha = 0;
        delay: number;
        gx = 0; gy = 0;        // glitch offset
        gt = 0;                 // glitch timer

        constructor(d: PData) {
            this.ix = d.x * sc;
            this.iy = d.y * sc;
            this.x  = this.ix;
            this.y  = this.iy;
            this.br = d.brightness;
            this.ll = Math.max(1, Math.round(d.lineLength * sc));
            this.lw = size <= 280 ? 1.5 : 2;
            this.baseAlpha = 0.5 + (d.brightness / 255) * 0.5;
            this.delay     = Math.random() * DELAY_MAX;
        }

        update() {
            const elapsed = (performance.now() - t0) / 1000 - this.delay;
            if (elapsed < 0) return;

            // Glitch on hover
            if (mouse.on) {
                const dx = this.x - mouse.x;
                const dy = this.y - mouse.y;
                const dist = Math.hypot(dx, dy);
                if (dist < mouseRadius && dist > 0) {
                    this.gt++;
                    if (this.gt % GLITCH_FREQ === 0) {
                        const k = (1 - dist / mouseRadius) * GLITCH_INTENS;
                        this.gx = (Math.random() - 0.5) * k;
                        this.gy = (Math.random() - 0.5) * k;
                    }
                    if (Math.random() < GLITCH_PROB && dist < mouseRadius * 0.5) {
                        this.gx = (Math.random() - 0.5) * GLITCH_STRONG;
                        this.gy = (Math.random() - 0.5) * GLITCH_STRONG;
                    }
                } else {
                    this.gx *= GLITCH_DECAY; this.gy *= GLITCH_DECAY;
                }
            } else {
                this.gx *= GLITCH_DECAY; this.gy *= GLITCH_DECAY;
            }

            // Spring toward image target
            const mp   = Math.min(elapsed / MOVE_DUR, 1);
            const pull = PULL_BASE + (1 - Math.pow(1 - mp, 3)) * PULL_MAX;
            this.vx += (this.ix - this.x) * pull;
            this.vy += (this.iy - this.y) * pull;
            this.vx *= FRICTION; this.vy *= FRICTION;
            this.x  += this.vx;  this.y  += this.vy;
        }

        draw() {
            const elapsed = (performance.now() - t0) / 1000 - this.delay;
            if (elapsed < 0) return;

            const fade = 1 - Math.pow(1 - Math.min(elapsed / FADE_DUR, 1), 2);
            this.alpha = this.baseAlpha * fade;

            const t = this.br / 255;
            const r = Math.round(DARK.r + (LIGHT.r - DARK.r) * t);
            const g = Math.round(DARK.g + (LIGHT.g - DARK.g) * t);
            const b = Math.round(DARK.b + (LIGHT.b - DARK.b) * t);
            let   a = this.alpha;
            if (Math.abs(this.gx) > SCAN_THRESH) a *= 0.7;

            ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
            ctx.lineWidth   = this.lw;
            ctx.lineCap     = 'butt';
            ctx.globalAlpha = 1;
            ctx.beginPath();
            ctx.moveTo(this.x + this.gx, this.y + this.gy);
            ctx.lineTo(this.x + this.gx + this.ll, this.y + this.gy);
            ctx.stroke();
        }
    }

    let particles: Particle[]        = [];
    let floaters:  FloatingParticle[] = [];

    function setup(newSize: number) {
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }

        size        = newSize;
        sc          = size / REF;
        mouseRadius = MOUSE_RAD_REF * sc;

        canvas.width  = size;
        canvas.height = size;
        ctx.imageSmoothingEnabled = false;

        t0        = performance.now();
        particles = particleData.particles.map(d => new Particle(d));
        floaters  = Array.from({ length: FLOAT_N }, () => new FloatingParticle());

        loop();
    }

    function loop() {
        ctx.clearRect(0, 0, size, size);
        floaters.forEach(f => { f.update(); f.draw(); });
        particles.forEach(p => { p.update(); p.draw(); });
        rafId = requestAnimationFrame(loop);
    }

    // ---- Responsive via ResizeObserver ----
    let resizeDebounce: ReturnType<typeof setTimeout> | null = null;

    const ro = new ResizeObserver((entries) => {
        const { width, height } = entries[0].contentRect;
        if (width <= 0) return;
        const newSize = Math.floor(height > 0 ? Math.min(width, height) : width);
        if (newSize === size && ready) return;
        if (resizeDebounce) clearTimeout(resizeDebounce);
        resizeDebounce = setTimeout(() => {
            ready = true;
            setup(newSize);
            resizeDebounce = null;
        }, ready ? 150 : 0);
    });

    ro.observe(wrapper);

    // ---- View Transitions cleanup ----
    document.addEventListener('astro:before-preparation', () => {
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        ro.disconnect();
    }, { once: true });
</script>
