---
interface Props {
    text: string;
    link: string;
    target?: string;
}

const { text, link, target } = Astro.props as Props;
---

<a href={link}
    class="glass-bg text-text-primary py-3 px-8 rounded-md font-display
    font-medium text-center transition-transform transform hover:scale-105 text-sm sm:text-base lg:text-lg"
    target={target}
>
{text}
</a>

<style>
    .glass-bg {
        background: rgba(0, 0, 0, 0.004);
        border: 1px solid rgba(72, 72, 72, 0.3);
        border-radius: 6px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .glass-bg:hover {
        background: rgba(0, 0, 0, 0.11);
        border-color: rgba(72, 72, 72, 0.5);
        box-shadow: 0 6px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
</style>
