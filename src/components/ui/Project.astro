---
const { title, description, techStack, imageUrl, projectUrl, githubUrl } = Astro.props;
---

<div class="project-container">
    <div class="div1">
        <h3 class="font-body text-text-primary font-light text-2xl sm:text-3xl lg:text-4xl">
            {title}
        </h3>
        <p class="font-body text-text-secondary h-full font-light text-lg sm:text-xl lg:text-2xl z-20 flex items-end">
            {description}
        </p>
    </div>
    <div class="div2">
        <h4 class="font-body text-text-primary font-light text-lg sm:text-xl lg:text-2xl">
            Tech Stack
        </h4>
        <ul class="list-disc list-inside font-body text-text-secondary h-full font-light text-base sm:text-lg lg:text-xl z-20 flex items-start gap-1">
            {techStack.map((tech: unknown) => (
                <li>{tech}</li>
            ))}
        </ul>
    </div>
    <div class="div3">
        <a href={projectUrl} target="_blank" class="text-accent hover:underline">View Project</a>
    </div>
    <div class="div4">
        <a href={githubUrl} target="_blank" class="text-accent hover:underline">View Code</a>
    </div>
</div>

<style>
    .project-container {
        display: grid;
        grid-template-columns: 8fr 1fr;
        grid-template-rows: 16fr repeat(2, 4fr) 3fr;
        grid-column-gap: 0px;
        grid-row-gap: 0px;
    }
    .div1 { grid-area: 2 / 1 / 3 / 2; }
    .div2 { grid-area: 3 / 1 / 4 / 2; }
    .div3 { grid-area: 4 / 1 / 5 / 2; }
    .div4 { grid-area: 4 / 2 / 5 / 3; }
</style>