---
import { Image } from 'astro:assets';
import type { Project } from '../../types/project';
import GithubIcon from '@components/icons/GithubIcon.astro';
import OpenLinkIcon from '@components/icons/OpenLinkIcon.astro';
type Props = Project;

const { title, description, techStack, imageUrl, projectUrl, githubUrl } = Astro.props;
---

<div class="project-container rounded-2xl overflow-hidden shadow-lg">
    <div class="div1 z-20 flex items-end px-6">
        <h3 class="font-body text-text-primary font-bold text-md sm:text-lg lg:text-xl">
            {title}
        </h3>
    </div>
    <div class="div2 z-20 flex items-center px-6">
        <p class="font-body text-text-secondary h-full font-normal text-xs sm:text-xs lg:text-md z-20 flex items-center">
            {description}
        </p>
    </div>
    <div class="div3 z-20 flex items-center px-6">
        <ul class="list-none list-inside font-display text-accent h-full font-bold text-xs sm:text-xs lg:text-xs z-20 flex items-center gap-4">
            {techStack.map((tech: unknown, index: number) => (
                <>
                    <li>{tech}</li>
                    {index < techStack.length - 1 && <span>•</span>}
                </>
            ))}
        </ul>
    </div>
    <div class="div4 z-20 p-3 flex items-center justify-center gap-6">
        <a href={githubUrl} target="_blank" class="text-text-primary hover:underline hover:scale-110 transition-transform duration-300"><GithubIcon class="w-5 h-5"/></a>
        <a href={projectUrl} target="_blank" class="text-text-primary hover:underline hover:scale-110 transition-transform duration-300"><OpenLinkIcon class="w-5 h-5"/></a>
    </div>
    <div class="col-start-1 col-end-3 row-start-1 row-end-5 z-15 image-gradient"></div>
    <div class="col-start-1 col-end-3 row-start-1 row-end-5 z-10">
        <Image
            src={imageUrl}
            alt={`${title} screenshot`}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
            quality={80}
        />
    </div>
</div>

<style>
    .project-container {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: 1fr auto auto auto;
        height: 100%;
        width: 100%;
    }
    .div1 {
        grid-area: 2 / 1 / 3 / 2;
        /* background-color: rgba(255, 0, 0, 0.1); */
    }
    .div2 {
        grid-area: 3 / 1 / 4 / 2;
        /* background-color: rgba(0, 255, 0, 0.1); */
    }
    .div3 {
        grid-area: 4 / 1 / 5 / 2;
        /* background-color: rgba(0, 0, 255, 0.1); */
    }
    .div4 {
        grid-area: 4 / 2 / 5 / 3;
        /* background-color: rgba(255, 255, 0, 0.1); */
    }
    .image-gradient {
        background: linear-gradient(to bottom, transparent 10%, #131313 85%);
    }
</style>