---
import { navItems } from "@consts/navbar.ts";
---

<nav
    class="bg-bg/60 backdrop-blur-xl
           rounded-2xl px-8 py-3
           shadow-glow
           flex items-center gap-8
           border border-white/5"
    aria-label="Main navigation"
>
    <span class="font-display font-bold text-lg text-text-primary mr-4">
        Samu0xdev
    </span>

    <ul class="flex items-center gap-6 list-none m-0 p-0
               font-body text-xs uppercase tracking-tight">
        {navItems.map(({ label, href, active }) => (
            <li>
                <a
                    href={href}
                    data-section={label.toLowerCase()}
                    class:list={[
                        "transition-all duration-300 ease-in-out",
                        active
                            ? "text-accent border-b border-accent/30 pb-0.5"
                            : "text-text-secondary hover:text-text-primary",
                    ]}
                >
                    {label}
                </a>
            </li>
        ))}
    </ul>
</nav>

<script>
    function setActiveLink(hash: string) {
        const anchors = document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]');
        const normalizedHash = hash || window.location.hash || '#hero-section';

        anchors.forEach((anchor) => {
            const href = anchor.getAttribute('href')!;
            const isActive = href === normalizedHash || (normalizedHash === '' && href === '#hero-section');

            anchor.classList.toggle('text-accent', isActive);
            anchor.classList.toggle('border-b', isActive);
            anchor.classList.toggle('border-accent/30', isActive);
            anchor.classList.toggle('pb-0.5', isActive);
            anchor.classList.toggle('text-text-secondary', !isActive);
            anchor.classList.toggle('hover:text-text-primary', !isActive);
        });
    }

    function initHashScroll() {
        const anchors = document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]');

        anchors.forEach((anchor) => {
            anchor.addEventListener('click', (e) => {
                e.preventDefault();
                const href = anchor.getAttribute('href')!;

                if (href === '#') {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    history.pushState(null, '', '#');
                    setActiveLink('#hero-section');
                } else {
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                        history.pushState(null, '', href);
                        setActiveLink(href);
                    }
                }
            });
        });

        window.addEventListener('hashchange', () => setActiveLink(window.location.hash));
        setActiveLink(window.location.hash);
    }

    // Inicializar en carga inicial y tras cada view transition
    document.addEventListener('astro:page-load', initHashScroll);
</script>