---
import { links } from "@consts/social-dock.ts";
import LangSwitcher from "@components/ui/LangSwitcher.astro";
import type { Lang } from "@i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
---

<aside
    class="hidden md:flex bg-bg/60 backdrop-blur-xl
           rounded-2xl px-4 py-3
           shadow-glow
           items-center gap-1
           border border-white/5"
    aria-label="Social links"
>
    {links.map(({ label, href, icon }) => (
        <a
            href={href}
            target={href.startsWith("mailto") ? "_self" : "_blank"}
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="text-text-secondary hover:text-accent
                   transition-all duration-300
                   hover:scale-120
                   p-1.5 flex items-center"
            set:html={icon}
        />
    ))}
    <span class="w-px h-5 bg-white/10 mx-2" aria-hidden="true"></span>
    <LangSwitcher lang={lang} />
</aside>
