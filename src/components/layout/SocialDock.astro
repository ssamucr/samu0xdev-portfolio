---

<!--
  Espejo del NavBar: fixed top-6 right-6, mismo vidrio y sombra.
  target="_blank" solo para links externos; email abre el cliente local.
  rel="noopener noreferrer": seguridad obligatoria en _blank (evita tabnapping).
  aria-label en cada <a>: el SVG tiene aria-hidden, el label accesible va en el <a>.
-->
<aside
    class="fixed top-6 right-6 z-50
           bg-bg/60 backdrop-blur-xl
           rounded-full px-4 py-3
           shadow-glow
           flex items-center gap-1
           border border-white/5"
    aria-label="Social links"
>
    {links.map(({ label, href, icon }) => (
        <a
            href={href}
            target={href.startsWith("mailto") ? "_self" : "_blank"}
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="text-text-secondary hover:text-accent
                   transition-all duration-300
                   hover:scale-110
                   p-1.5 flex items-center"
            set:html={icon}
        />
    ))}
</aside>


