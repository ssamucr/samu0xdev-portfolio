---
import { useTranslations, type Lang } from "@i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 mt-32 py-10 px-8">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-center">

        <p class="font-body text-xs text-text-secondary tracking-tight text-center">
              {t('footer.credits')} <br>{t('footer.rights')} &copy; {year}
        </p>

    </div>
</footer>
