---
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE_INFO } from "@consts/site-info";
import { useTranslations, getLangUrl, LANGUAGES, type Lang } from "@i18n/ui";
import NavBar from "@components/layout/NavBar.astro";
import Footer from "@components/layout/Footer.astro";
import SocialDock from "@components/layout/SocialDock.astro";
import HeroSection from "@components/sections/HeroSection.astro";

interface Props {
    lang: Lang;
    title: string;
    description?: string;
    image?: string;
}

const {
    lang
    , title=SITE_INFO.title
    , description
    , image
} = Astro.props as Props;

const t = useTranslations(lang);
const metaDescription = description ?? t('site.description');

---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!-- SEO -->
        <meta name="description" content={metaDescription} />
        <meta name="author" content="Samuel Castro" />

        <!-- OG Metatags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <!-- {image && <meta property="og:image" content={image} />} -->

        <!-- i18n -->
        {(Object.keys(LANGUAGES) as Lang[]).map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(getLangUrl(l), Astro.site ?? Astro.url).href} />
        ))}

        <ClientRouter />
	</head>
	<body>
		<header class="fixed top-4 md:top-6 left-0 right-0 z-50">
			<div class="w-full max-w-7xl mx-auto px-4 md:px-6 flex items-center justify-between">
				<NavBar lang={lang} />
				<SocialDock lang={lang} />
			</div>
        </header>
        <HeroSection lang={lang} />
		<main class="max-w-7xl mx-auto px-4 sm:px-6">
            <slot />
        </main>
		<Footer lang={lang} />
	</body>
</html>
